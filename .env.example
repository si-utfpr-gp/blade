# Credenciais do Google OAuth.
#
# Copie para .env e preencha. O .env já está no .gitignore e nunca deve ser
# commitado.
#
# 1. Google Cloud Console > APIs e serviços > Credenciais
# 2. Criar credenciais > ID do cliente OAuth 2.0 > Aplicativo da Web
# 3. URI de redirecionamento autorizado:
#      http://localhost:3000/auth/google_oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domínios institucionais permitidos, separados por vírgula.
# Vazio = aceita qualquer conta Google.
# Exemplo: utfpr.edu.br,alunos.utfpr.edu.br
GOOGLE_ALLOWED_DOMAINS=

# true = mostra a tela de login real no localhost, em vez do usuário de
# desenvolvimento automático. Use para testar o fluxo completo antes de subir.
FORCE_GOOGLE_LOGIN=
