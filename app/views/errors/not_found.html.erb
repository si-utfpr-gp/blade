<% content_for :title, "Página não encontrada · Blade" %>
<div class="landing relative flex min-h-screen flex-col overflow-clip bg-background text-foreground">
  <div aria-hidden="true" class="landing-grid pointer-events-none absolute inset-0 -z-10"></div>

  <main class="mx-auto flex max-w-xl flex-1 flex-col items-center justify-center px-4 py-20 text-center">
    <%# The end block of the flowchart: the path the visitor took leads nowhere. %>
    <svg width="120" height="56" viewBox="0 0 120 56" aria-hidden="true" class="landing-rise">
      <ellipse cx="60" cy="28" rx="56" ry="24" fill="white" stroke="hsl(var(--node-end))" stroke-width="3" />
      <text x="60" y="35" text-anchor="middle" font-size="22" font-weight="700" fill="hsl(var(--node-end))">404</text>
    </svg>

    <h1 class="landing-rise mt-8 text-4xl font-medium tracking-tight text-slate-900 sm:text-5xl" style="animation-delay: 60ms">
      Página não encontrada
    </h1>
    <p class="landing-rise mt-4 text-lg text-slate-600" style="animation-delay: 120ms">
      Esse caminho não leva a nenhum bloco. Confira o endereço ou volte para um lugar conhecido.
    </p>

    <div class="landing-rise mt-10 flex flex-col gap-3 sm:flex-row" style="animation-delay: 180ms">
      <a href="/" class="rounded-full bg-slate-900 px-7 py-3.5 text-base font-semibold text-white hover:bg-slate-700">Página inicial</a>
      <a href="/builder" class="rounded-full px-7 py-3.5 text-base font-semibold text-slate-700 ring-1 ring-slate-300 hover:ring-slate-400">Abrir o builder</a>
    </div>
  </main>
</div>
