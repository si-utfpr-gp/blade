<% content_for :title, "Entrar · Blade" %>
<%
  first_name = @user&.name.to_s.split.first
  arrow = '<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.64l-3.97-3.97a.75.75 0 111.06-1.06l5.25 5.25a.75.75 0 010 1.06l-5.25 5.25a.75.75 0 11-1.06-1.06l3.97-3.97H3.75A.75.75 0 013 10z" clip-rule="evenodd"/></svg>'.html_safe
%>

<div class="landing relative flex min-h-screen flex-col overflow-hidden bg-slate-50 text-foreground">
  <div aria-hidden="true" class="landing-grid pointer-events-none absolute inset-0"></div>
  <div aria-hidden="true" class="landing-glow pointer-events-none absolute -left-40 -top-40 h-[30rem] w-[30rem] rounded-full" style="--glow: var(--node-process)"></div>
  <div aria-hidden="true" class="landing-glow pointer-events-none absolute -bottom-48 -right-32 h-[30rem] w-[30rem] rounded-full" style="--glow: var(--node-decision); animation-delay: -8s"></div>

  <header class="relative z-10 mx-auto flex w-full max-w-5xl items-center justify-between px-4 py-5 sm:px-6">
    <a href="/" class="flex items-center gap-2" aria-label="Blade, página inicial">
      <svg class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M12 14l9-5-9-5-9 5 9 5z" />
        <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
      </svg>
      <span class="text-2xl font-bold tracking-tight">Blade</span>
    </a>
    <a href="/" class="text-base font-medium text-slate-600 hover:text-slate-900">← Voltar para o início</a>
  </header>

  <main class="relative z-10 mx-auto flex w-full max-w-5xl flex-1 flex-col justify-center px-4 pb-16 pt-6 sm:px-6">
    <div class="landing-rise text-center">
      <h1 class="text-4xl font-medium tracking-tight text-slate-900 sm:text-5xl">Entrar no Blade</h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-slate-600 sm:text-xl">
        <% if @user %>
          Você já entrou como <strong class="font-semibold text-slate-900"><%= @user.name %></strong>.
        <% else %>
          Escolha como quer acessar.
        <% end %>
      </p>
    </div>

    <% if @error.present? %>
      <p role="alert" class="landing-rise mx-auto mt-8 w-full max-w-xl rounded-xl border border-destructive/40 bg-destructive/10 px-4 py-3 text-center text-base text-destructive">
        <%= @error %>
      </p>
    <% end %>

    <% if @user %>
      <div class="landing-rise mx-auto mt-10 flex w-full max-w-md flex-col gap-3" style="animation-delay: 80ms">
        <a href="/builder" class="inline-flex items-center justify-center gap-2 rounded-full bg-slate-900 px-7 py-4 text-base font-semibold text-white hover:bg-slate-700">
          Continuar como <%= first_name %> <%= arrow %>
        </a>
        <%= form_with url: "/logout", method: :post, data: { turbo: false }, local: true do %>
          <button type="submit" class="w-full rounded-full px-7 py-4 text-base text-slate-600 ring-1 ring-slate-300 hover:text-slate-900 hover:ring-slate-400">
            Não é você? Sair
          </button>
        <% end %>
      </div>
    <% else %>
      <div class="mt-10 grid gap-5 md:grid-cols-2 md:gap-6">
        <section data-access="aluno" class="landing-rise landing-access flex flex-col rounded-3xl p-7 shadow-xl shadow-blue-600/10 ring-2 ring-blue-600 sm:p-9" style="--c: var(--node-start); animation-delay: 80ms">
          <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-blue-600" aria-hidden="true">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 14l9-5-9-5-9 5 9 5z" /><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /></svg>
          </span>
          <h2 class="mt-5 text-2xl font-semibold text-slate-900">Acessar como aluno</h2>
          <p class="mt-3 text-base leading-7 text-slate-600">
            Entre com sua conta Google da UTFPR para salvar seus algoritmos e reabrir quando quiser.
          </p>
          <ul class="mt-5 space-y-2.5 text-base text-slate-700">
            <li class="landing-check">Tudo do visitante</li>
            <li class="landing-check">Salvar e reabrir algoritmos</li>
            <li class="landing-check">Lista dos seus algoritmos</li>
          </ul>
          <%# data-turbo="false" is required: Turbo would intercept the POST and
              follow the redirect to Google with fetch, breaking the handshake. %>
          <%= form_with url: "/auth/google_oauth2", method: :post, data: { turbo: false }, local: true, class: "mt-auto pt-8" do %>
            <button type="submit"
                    class="flex w-full items-center justify-center gap-3 rounded-full bg-slate-900 px-6 py-4 text-base font-semibold text-white hover:bg-slate-700">
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-white">
                <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47a5.54 5.54 0 01-2.4 3.63v3h3.88c2.27-2.09 3.58-5.17 3.58-8.87z"/>
                  <path fill="#34A853" d="M12 24c3.24 0 5.96-1.08 7.95-2.91l-3.88-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09A12 12 0 0012 24z"/>
                  <path fill="#FBBC05" d="M5.27 14.29a7.2 7.2 0 010-4.58V6.62H1.29a12 12 0 000 10.76l3.98-3.09z"/>
                  <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0A12 12 0 001.29 6.62l3.98 3.09C6.22 6.86 8.87 4.75 12 4.75z"/>
                </svg>
              </span>
              Entrar com Google
            </button>
          <% end %>
        </section>

        <section data-access="visitante" class="landing-rise landing-access flex flex-col rounded-3xl p-7 ring-1 ring-slate-200 sm:p-9" style="--c: var(--node-connector); animation-delay: 160ms">
          <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100 text-slate-600" aria-hidden="true">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12s3.5-7 9.5-7 9.5 7 9.5 7-3.5 7-9.5 7-9.5-7-9.5-7z" /><circle cx="12" cy="12" r="3" /></svg>
          </span>
          <h2 class="mt-5 text-2xl font-semibold text-slate-900">Acessar como visitante</h2>
          <p class="mt-3 text-base leading-7 text-slate-600">
            Use o builder sem conta. Ele não salva: para guardar o que fizer, exporte em JSON.
          </p>
          <ul class="mt-5 space-y-2.5 text-base text-slate-700">
            <li class="landing-check">Desenhar fluxogramas</li>
            <li class="landing-check">Executar com teste de mesa</li>
            <li class="landing-check">Ver o código e exportar JSON</li>
            <li class="landing-cross">Salvar algoritmos</li>
          </ul>
          <div class="mt-auto pt-8">
            <a href="/builder"
               class="flex w-full items-center justify-center gap-2 rounded-full px-6 py-4 text-base font-semibold text-slate-800 ring-1 ring-slate-300 hover:ring-slate-400">
              Acessar como visitante <%= arrow %>
            </a>
          </div>
        </section>
      </div>
    <% end %>

    <p class="mt-10 text-center text-sm text-slate-500">
      Ao entrar você concorda com o uso acadêmico da ferramenta.
    </p>
  </main>
</div>
