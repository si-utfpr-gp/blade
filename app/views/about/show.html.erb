<% content_for :title, "Sobre · Blade" %>
<%
  developers = [
    ["Lucas Gontarz Fajardo", "lucasgfaj"],
    ["Emanuel Oliveira Andrade", "emanuel-o-dev"]
  ]
  advisors = [
    ["Prof. Dr. Diego Marczal", "MarczalTSIGP"],
    ["Profª. Drª. Renata Luiza Stange", "rlstange-utfpr"]
  ]
  repository = "https://github.com/si-utfpr-gp/blade"
  contact = "marczal@utfpr.edu.br"
%>

<div class="landing relative overflow-clip bg-background text-foreground">
  <%# ---------------------------------------------------------------- nav %>
  <%= render "shared/site_header", links: [["Início", "/"], ["Blocos", "/blocks"], ["Sobre", "/about"]], current: "/about" %>

  <%# --------------------------------------------------------------- intro %>
  <section class="relative z-10 mx-auto max-w-4xl px-4 pb-16 pt-12 sm:px-6 lg:pt-20">
    <div aria-hidden="true" class="landing-grid pointer-events-none absolute inset-x-0 -top-24 bottom-0 -z-10"></div>
    <div aria-hidden="true" class="landing-glow pointer-events-none absolute -right-40 -top-32 -z-10 h-[28rem] w-[28rem] rounded-full opacity-30" style="--glow: 217 91% 60%"></div>

    <p class="landing-rise inline-flex items-center gap-2 rounded-full bg-blue-50 px-3 py-1 font-mono text-sm text-blue-600 ring-1 ring-blue-100">
      <span class="h-1.5 w-1.5 rounded-full bg-blue-600" aria-hidden="true"></span>/about
    </p>
    <h1 class="landing-rise mt-4 text-4xl font-medium tracking-tight text-slate-900 sm:text-6xl" style="animation-delay: 60ms">
      Sobre o
      <span class="relative whitespace-nowrap text-blue-600"><%= render "shared/scribble" %><span class="relative">Blade</span></span>
    </h1>
    <p class="landing-rise mt-6 max-w-3xl text-lg text-slate-700 sm:text-xl" style="animation-delay: 120ms">
      O Blade é uma ferramenta para aprender lógica de programação com fluxogramas. O aluno monta o algoritmo
      arrastando blocos, executa passo a passo, acompanha as variáveis no teste de mesa e compara o diagrama
      com o código equivalente em JavaScript e TypeScript.
    </p>
    <p class="landing-rise mt-4 max-w-3xl text-lg text-slate-700 sm:text-xl" style="animation-delay: 180ms">
      É um projeto acadêmico e de código aberto, desenvolvido no curso de
      <strong class="font-semibold text-slate-900">Sistemas de Informação</strong> da
      <strong class="font-semibold text-slate-900">Universidade Tecnológica Federal do Paraná (UTFPR), câmpus Guarapuava</strong>.
    </p>

    <ul class="mt-8 flex flex-wrap gap-2 text-sm font-medium text-slate-700">
      <% [ [ "Código aberto", "--node-process" ], [ "UTFPR Guarapuava", "--node-start" ], [ "Sistemas de Informação", "--node-output" ] ].each_with_index do |(label, token), i| %>
        <li class="landing-rise inline-flex items-center gap-2 rounded-full bg-white px-3.5 py-1.5 ring-1 ring-slate-200" style="animation-delay: <%= 240 + i * 50 %>ms">
          <span class="h-2 w-2 rounded-full" style="background: hsl(var(<%= token %>))" aria-hidden="true"></span><%= label %>
        </li>
      <% end %>
    </ul>
  </section>

  <%# ---------------------------------------------------------------- team %>
  <section aria-labelledby="equipe" class="mx-auto max-w-4xl px-4 pb-16 sm:px-6">
    <h2 id="equipe" class="text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl">Desenvolvimento</h2>
    <p class="mt-2 text-base text-slate-600">Responsáveis pelo desenvolvimento do Blade.</p>

    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <% developers.each do |name, handle| %>
        <a href="https://github.com/<%= handle %>" target="_blank" rel="noopener"
           class="landing-reveal group flex items-center gap-4 rounded-2xl bg-white p-5 ring-1 ring-slate-200 transition-[box-shadow,translate,scale] duration-200 ease-out hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-900/5 hover:ring-blue-600 active:scale-[0.98]">
          <img src="https://github.com/<%= handle %>.png?size=128" alt="" width="56" height="56" loading="lazy"
               class="h-14 w-14 shrink-0 rounded-full bg-slate-100 ring-1 ring-slate-200 transition-[box-shadow] duration-200 group-hover:ring-2 group-hover:ring-blue-600">
          <span>
            <span class="block text-lg font-semibold text-slate-900"><%= name %></span>
            <span class="block font-mono text-sm text-slate-500">@<%= handle %></span>
          </span>
        </a>
      <% end %>
    </div>
  </section>

  <%# -------------------------------------------------------------- advisors %>
  <section aria-labelledby="orientacao" class="mx-auto max-w-4xl px-4 pb-16 sm:px-6">
    <h2 id="orientacao" class="text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl">Orientadores e professores</h2>
    <p class="mt-2 text-base text-slate-600">
      Orientadores do projeto e professores responsáveis pela disciplina Pensamento Computacional e Linguagem de Programação Visual.
    </p>

    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <% advisors.each do |name, handle| %>
        <a href="https://github.com/<%= handle %>" target="_blank" rel="noopener"
           class="landing-reveal group flex items-center gap-4 rounded-2xl bg-white p-5 ring-1 ring-slate-200 transition-[box-shadow,translate,scale] duration-200 ease-out hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-900/5 hover:ring-blue-600 active:scale-[0.98]">
          <img src="https://github.com/<%= handle %>.png?size=128" alt="" width="56" height="56" loading="lazy"
               class="h-14 w-14 shrink-0 rounded-full bg-slate-100 ring-1 ring-slate-200 transition-[box-shadow] duration-200 group-hover:ring-2 group-hover:ring-blue-600">
          <span>
            <span class="block text-lg font-semibold text-slate-900"><%= name %></span>
            <span class="block font-mono text-sm text-slate-500">@<%= handle %></span>
          </span>
        </a>
      <% end %>
    </div>
  </section>

  <%# ----------------------------------------------- contributors & source %>
  <section aria-label="Código e contato" class="mx-auto max-w-4xl px-4 pb-20 sm:px-6 sm:pb-28">
    <div class="grid gap-4 md:grid-cols-2">
      <article class="landing-reveal landing-access rounded-2xl p-7 ring-1 ring-slate-200" style="--c: var(--node-process)">
        <h2 class="text-xl font-semibold text-slate-900">Código aberto</h2>
        <p class="mt-3 text-base text-slate-700">
          O código está no GitHub, na organização do curso. Sugestões, issues e pull requests são bem-vindos.
        </p>
        <div class="mt-5 flex flex-col gap-2">
          <a href="<%= repository %>" target="_blank" rel="noopener" class="font-mono text-base font-semibold text-blue-600 hover:text-blue-500">si-utfpr-gp/blade</a>
          <a href="<%= repository %>/graphs/contributors" target="_blank" rel="noopener" class="text-base font-semibold text-blue-600 hover:text-blue-500">Ver todos os contribuidores</a>
        </div>
      </article>

      <article class="landing-reveal landing-access rounded-2xl p-7 ring-1 ring-slate-200" style="--c: var(--node-output)">
        <h2 class="text-xl font-semibold text-slate-900">Contato</h2>
        <p class="mt-3 text-base text-slate-700">
          Dúvidas sobre o projeto, uso em sala ou parcerias podem ser enviadas por e-mail.
        </p>
        <a href="mailto:<%= contact %>" class="mt-5 inline-block font-mono text-base font-semibold text-blue-600 hover:text-blue-500"><%= contact %></a>
      </article>
    </div>
  </section>

  <%= render "shared/site_footer" %>
</div>
