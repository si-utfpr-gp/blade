<%
  # The header of the public pages. `links` are the page's own navigation, as
  # [label, href] pairs; `current` marks the page the visitor is on. From md up
  # the links sit in the bar; below it they move into a menu behind a
  # hamburger, a <details> so it opens without JavaScript.
  current = local_assigns[:current]
  first_name = @user&.name.to_s.split.first
  press = "transition-[color,background-color,box-shadow,scale,translate] duration-150 ease-out active:scale-[0.97]"
  arrow = '<svg class="h-4 w-4 transition-transform duration-150 ease-out group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.64l-3.97-3.97a.75.75 0 111.06-1.06l5.25 5.25a.75.75 0 010 1.06l-5.25 5.25a.75.75 0 11-1.06-1.06l3.97-3.97H3.75A.75.75 0 013 10z" clip-rule="evenodd"/></svg>'.html_safe
%>
<%# Sticky, so the routes stay one tap away while the page scrolls. %>
<div class="sticky top-0 z-30 border-b border-slate-200/70 bg-white/80 backdrop-blur-md">
<header class="relative mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
  <div class="flex items-center gap-10">
    <a href="/" class="flex items-center gap-2" aria-label="Blade, página inicial">
      <svg class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M12 14l9-5-9-5-9 5 9 5z" />
        <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
      </svg>
      <span class="text-2xl font-bold tracking-tight">Blade</span>
    </a>
    <nav class="hidden gap-1 text-base text-slate-700 md:flex" aria-label="Seções">
      <% links.each do |label, href| %>
        <% if href == current %>
          <a href="<%= href %>" class="rounded-lg bg-slate-100 px-3 py-1.5" aria-current="page"><%= label %></a>
        <% else %>
          <a href="<%= href %>" class="rounded-lg px-3 py-1.5 hover:bg-slate-100"><%= label %></a>
        <% end %>
      <% end %>
    </nav>
  </div>

  <div class="hidden items-center gap-5 md:flex">
    <% if @user %>
      <a href="/builder" class="group inline-flex items-center gap-1.5 rounded-full bg-blue-600 px-5 py-2.5 text-base font-semibold text-white hover:bg-blue-500 <%= press %>">
        Continuar como <%= first_name %> <%= arrow %>
      </a>
    <% else %>
      <a href="/login" class="text-base font-medium text-slate-700 transition-colors duration-150 hover:text-slate-900">Entrar</a>
      <a href="/builder" class="rounded-full bg-blue-600 px-5 py-2.5 text-base font-semibold text-white hover:bg-blue-500 <%= press %>">
        Abrir o builder
      </a>
    <% end %>
  </div>

  <details data-mobile-menu data-controller="site-menu" class="site-menu md:hidden">
    <summary aria-label="Abrir menu" class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg text-slate-700 ring-1 ring-slate-200 hover:bg-slate-100">
      <svg class="site-menu-open h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg class="site-menu-close h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
    </summary>
    <div class="site-menu-panel absolute inset-x-4 top-full mt-1 rounded-2xl bg-white p-3 shadow-xl shadow-slate-900/10 ring-1 ring-slate-200">
      <nav class="flex flex-col text-base text-slate-700" aria-label="Menu" data-action="click->site-menu#close">
        <% ([["Início", "/"]] + links).uniq.each do |label, href| %>
          <a href="<%= href %>" class="rounded-lg px-3 py-2.5 hover:bg-slate-100<%= ' bg-slate-100 font-medium text-slate-900' if href == current %>"<%= ' aria-current="page"'.html_safe if href == current %>><%= label %></a>
        <% end %>
      </nav>
      <div class="mt-2 flex flex-col gap-2 border-t border-slate-100 pt-3">
        <% if @user %>
          <a href="/builder" class="group inline-flex items-center justify-center gap-1.5 rounded-full bg-blue-600 px-5 py-3 text-base font-semibold text-white hover:bg-blue-500 <%= press %>">
            Continuar como <%= first_name %> <%= arrow %>
          </a>
        <% else %>
          <a href="/builder" class="rounded-full bg-blue-600 px-5 py-3 text-center text-base font-semibold text-white hover:bg-blue-500 <%= press %>">Abrir o builder</a>
          <a href="/login" class="rounded-full px-5 py-3 text-center text-base font-medium text-slate-700 ring-1 ring-slate-200 hover:bg-slate-50 <%= press %>">Entrar</a>
        <% end %>
      </div>
    </div>
  </details>
</header>
</div>
