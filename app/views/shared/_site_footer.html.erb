<%
  # The block palette in the order the builder lists it, drawn as a thin strip
  # so the colours a student meets here are the ones they draw with.
  palette = %w[
    --node-start --node-memory --node-input --node-process --node-decision
    --node-selection --node-output --node-subroutine --node-connector --node-end
  ]
  link = "text-slate-600 hover:text-slate-900"
%>
<footer class="border-t border-slate-200 bg-slate-50">
  <div class="flex h-1" aria-hidden="true">
    <% palette.each do |token| %>
      <span class="flex-1" style="background: hsl(var(<%= token %>))"></span>
    <% end %>
  </div>

  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1fr_auto_auto] md:gap-16">
    <div class="max-w-sm">
      <a href="/" class="flex items-center gap-2" aria-label="Blade, página inicial">
        <svg class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 14l9-5-9-5-9 5 9 5z" />
          <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
        </svg>
        <span class="text-lg font-bold tracking-tight text-slate-900">Blade</span>
      </a>
      <p class="mt-3 text-sm leading-6 text-slate-600">
        Algoritmos em blocos, passo a passo. Um projeto do curso de Sistemas de Informação da UTFPR Guarapuava.
      </p>
    </div>

    <nav aria-label="Navegação do rodapé">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-900">Blade</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/" class="<%= link %>">Início</a></li>
        <li><a href="/builder" class="<%= link %>">Builder</a></li>
        <li><a href="/blocks" class="<%= link %>">Blocos</a></li>
        <li><a href="/about" class="<%= link %>">Sobre</a></li>
      </ul>
    </nav>

    <nav aria-label="Projeto">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-900">Projeto</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="https://github.com/si-utfpr-gp/blade" class="<%= link %>" target="_blank" rel="noopener">GitHub</a></li>
        <li><a href="mailto:marczal@utfpr.edu.br" class="<%= link %>">Contato</a></li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-slate-200">
    <p class="mx-auto max-w-6xl px-4 py-5 text-xs text-slate-500 sm:px-6">
      © <%= Date.current.year %> Blade · Uso acadêmico
    </p>
  </div>
</footer>
